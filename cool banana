local function setupLuckToggle(btn, stateKey, multiplier)
    bindButton(btn, function()
        AppState[stateKey] = not AppState[stateKey]
        btn.Text = btn.Text:gsub(AppState[stateKey] and "OFF" or "ON", AppState[stateKey] and "ON" or "OFF")
        local grad = btn:FindFirstChildOfClass("UIGradient")
        if grad then grad.Color = AppState[stateKey] and ON_GRAD or OFF_GRAD end
    end)
    
    table.insert(TaskList, task.spawn(function()
        while true do
            if AppState[stateKey] then
                pcall(function()
                    LocalPlayer:SetAttribute("Luck", multiplier)
                    LocalPlayer:SetAttribute("LuckMultiplier", multiplier)
                end)
            end
            task.wait(0.5)
        end
    end))
end

