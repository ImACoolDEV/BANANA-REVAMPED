local targetCache, partCache = nil, nil
local lastTargetCheck = 0
local function locateTargetModel()
    if tick() - lastTargetCheck > 1.0 or not targetCache or not targetCache.Parent then
        targetCache, partCache = nil, nil
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and (obj.Name == "THE_RAKE" or obj.Name:lower():find("rake") or obj.Name:lower():find("rakoof") or obj:FindFirstChildOfClass("Humanoid")) then
                local p = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
                if p and obj ~= LocalPlayer.Character then
                    targetCache, partCache = obj, p
                    break
                end
            end
        end
        lastTargetCheck = tick()
    end
    return targetCache, partCache
end

