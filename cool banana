local bodyVel, bodyGyro
bindButton(FlyBtn, function()
    AppState.Fly = not AppState.Fly
    FlyBtn.Text = AppState.Fly and "🦅 Fly Hack: ON" or "🦅 Fly Hack: OFF"
    FlyG.Color = AppState.Fly and ON_GRAD or OFF_GRAD
    if ConnectionList.FlyConn then ConnectionList.FlyConn:Disconnect(); ConnectionList.FlyConn = nil end
    if bodyVel then bodyVel:Destroy(); bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    if AppState.Fly then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            bodyVel = Instance.new("BodyVelocity", hrp); bodyVel.MaxForce = Vector3.new(1,1,1)*1e6; bodyVel.Velocity = Vector3.zero
            bodyGyro = Instance.new("BodyGyro", hrp); bodyGyro.MaxTorque = Vector3.new(1,1,1)*1e6; bodyGyro.CFrame = hrp.CFrame
            ConnectionList.FlyConn = RunService.RenderStepped:Connect(function()
                if not AppState.Fly or not hrp then return end
                local cam = Workspace.CurrentCamera.CFrame
                bodyGyro.CFrame = cam
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
                bodyVel.Velocity = (dir.Magnitude > 0) and (dir.Unit * 60) or Vector3.zero
            end)
        end
    end
end)

